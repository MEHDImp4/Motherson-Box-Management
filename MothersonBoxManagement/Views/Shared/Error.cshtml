@model ErrorViewModel
@{
    ViewData["Title"] = Model.IsNotFound ? "Page introuvable" : "Erreur";
}

@if (Model.IsNotFound)
{
    <div class="error-page">
        <div class="error-page-icon">404</div>
        <h1 class="error-page-title">Page introuvable</h1>
        <p class="error-page-message">
            La page que vous recherchez n'existe pas ou a été déplacée.
            Vérifiez l'adresse ou retournez à l'accueil.
        </p>
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary-accent">
            Retour à l'accueil
        </a>
    </div>
}
else
{
    <div class="error-page">
        <div class="error-page-icon text-danger">!</div>
        <h1 class="error-page-title text-danger">Une erreur est survenue</h1>
        <p class="error-page-message">
            Une erreur inattendue s'est produite lors du traitement de votre demande.
        </p>
        @if (Model.ShowRequestId)
        {
            <p class="error-page-request-id">
                <strong>Identifiant de la demande :</strong> <code>@Model.RequestId</code>
            </p>
        }
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary-accent">
            Retour à l'accueil
        </a>
    </div>
}
