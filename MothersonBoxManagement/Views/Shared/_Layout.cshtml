@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@inject MothersonBoxManagement.Data.ApplicationDbContext DbContext
@inject Microsoft.Extensions.Caching.Memory.IMemoryCache Cache
@using System.Reflection
@using MothersonBoxManagement.Entities
@using Microsoft.Extensions.Caching.Memory
@using Microsoft.EntityFrameworkCore
@{
    var releaseVersion = Assembly.GetEntryAssembly()?
        .GetCustomAttribute<AssemblyInformationalVersionAttribute>();
    var requireStationName = ViewData["RequireStationName"] as bool? == true;
    var barcodeConfig = Cache.GetOrCreate("BarcodeConfig_Id1", entry =>
    {
        entry.AbsoluteExpirationRelativeToNow = TimeSpan.FromMinutes(30);
        return DbContext.BarcodeConfigurations.AsNoTracking().FirstOrDefault(bc => bc.Id == BarcodeConfiguration.DefaultId);
    });
    var boxPrefix = barcodeConfig?.BoxPrefix ?? "BOX-";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Motherson Box Management</title>
    <meta name="RequestVerificationToken" content="@Antiforgery.GetAndStoreTokens(Context).RequestToken" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body data-require-station-name="@requireStationName.ToString().ToLowerInvariant()" data-box-prefix="@boxPrefix">
    <script>
        if (localStorage.getItem('sidebar-collapsed') === 'true') {
            document.body.classList.add('sidebar-collapsed');
        }
    </script>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    
    @if (User.Identity?.IsAuthenticated == true)
    {
        var activeController = ViewContext.RouteData.Values["Controller"]?.ToString();
        var activeAction = ViewContext.RouteData.Values["Action"]?.ToString();
        
        <div class="app-shell">
            <!-- Sidebar Overlay for Mobile -->
            <div class="sidebar-overlay"></div>
            
            <!-- Sidebar Navigation -->
            <aside class="sidebar" role="navigation" aria-label="Sidebar navigation">
                <div class="sidebar-header d-flex align-items-center justify-content-between">
                    <a class="sidebar-brand" asp-controller="Dashboard" asp-action="Index">
                        <img src="~/images/motherson-logo.png" alt="Motherson" class="sidebar-logo" />
                        <span class="sidebar-brand-text">Box Management</span>
                    </a>
                    <button class="sidebar-collapse-btn d-none d-xl-flex" aria-label="Collapse sidebar" type="button">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" class="sidebar-collapse-icon"><polyline points="15 18 9 12 15 6"/></svg>
                    </button>
                </div>
                
                <nav class="sidebar-menu">
                    <span class="sidebar-menu-title">Operations</span>
                    <a class="sidebar-link @(activeController == "Dashboard" ? "active" : "")" asp-controller="Dashboard" asp-action="Index" title="Dashboard">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" class="sidebar-link-icon"><rect x="3" y="3" width="7" height="9"/><rect x="14" y="3" width="7" height="5"/><rect x="14" y="12" width="7" height="9"/><rect x="3" y="16" width="7" height="5"/></svg>
                        <span>Dashboard</span>
                    </a>
                    <a class="sidebar-link @(activeController == "Box" && activeAction == "Index" ? "active" : "")" asp-controller="Box" asp-action="Index" title="Search Boxes">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" class="sidebar-link-icon"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                        <span>Search Boxes</span>
                    </a>
                    <a class="sidebar-link @(activeController == "Box" && activeAction == "SearchPackage" ? "active" : "")" asp-controller="Box" asp-action="SearchPackage" title="Search Package">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" class="sidebar-link-icon"><path d="M20.24 12.24a6 6 0 0 0-8.49-8.49L5 10.5V19h8.5z"/><line x1="16" y1="8" x2="2" y2="22"/><line x1="17.5" y1="15" x2="9" y2="15"/></svg>
                        <span>Search Package</span>
                    </a>

                    <span class="sidebar-menu-title">Configuration</span>
                    <a class="sidebar-link @(activeController == "Box" && activeAction == "Settings" ? "active" : "")" asp-controller="Box" asp-action="Settings" title="Settings">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" class="sidebar-link-icon"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
                        <span>Settings</span>
                    </a>
                    @if (User.IsInRole("Superviseur") || User.IsInRole("Admin") || User.IsInRole("Supervisor") || User.IsInRole("Administrator"))
                    {
                    <a class="sidebar-link @(activeController == "BoxTemplate" ? "active" : "")" asp-controller="BoxTemplate" asp-action="Index" title="Box Templates">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" class="sidebar-link-icon"><polyline points="21 8 21 21 3 21 3 8"/><rect x="1" y="3" width="22" height="5"/><line x1="12" y1="12" x2="12" y2="21"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
                        <span>Box Templates</span>
                    </a>
                    }
                    
                    @if (User.IsInRole("Superviseur") || User.IsInRole("Admin") || User.IsInRole("Supervisor") || User.IsInRole("Administrator"))
                    {
                        <span class="sidebar-menu-title">Supervision</span>
                        <a class="sidebar-link @(activeController == "Audit" ? "active" : "")" asp-controller="Audit" asp-action="Index" title="Audit Log">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" class="sidebar-link-icon"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
                            <span>Audit Log</span>
                        </a>
                    }
                    
                    @if (User.IsInRole("Admin") || User.IsInRole("Administrator"))
                    {
                        <span class="sidebar-menu-title">Administration</span>
                        <a class="sidebar-link @(activeController == "PrintAgent" && activeAction == "Workstations" ? "active" : "")" asp-controller="PrintAgent" asp-action="Workstations" title="Workstation supervision">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" class="sidebar-link-icon"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M7 8h10M7 12h5M7 16h8"/></svg>
                            <span>Workstations</span>
                        </a>
                        <a class="sidebar-link @(activeController == "Users" ? "active" : "")" asp-controller="Users" asp-action="Index" title="User Accounts">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" class="sidebar-link-icon"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                            <span>User Accounts</span>
                        </a>
                        @await Component.InvokeAsync("PasswordResetNotification")
                    }
                </nav>
                
                <div class="sidebar-footer">
                    <div id="scannerStatus" class="sidebar-scanner-status" data-state="starting" role="status" aria-live="polite" title="Scanner status">
                        <span class="sidebar-scanner-dot" aria-hidden="true"></span>
                        <span class="sidebar-scanner-label">Scanner starting…</span>
                    </div>
                        @{
                            var sidebarUserName = User.FindFirst("FullName")?.Value;
                            if (string.IsNullOrWhiteSpace(sidebarUserName))
                            {
                                sidebarUserName = User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value ?? User.Identity?.Name;
                            }
                        }
                    <div class="sidebar-session">
                        <div class="sidebar-user">
                            <span class="sidebar-user-name">@sidebarUserName</span>
                            <span class="sidebar-user-role">@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</span>
                        </div>
                    </div>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="sidebar-signout-form">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="sidebar-signout" title="Sign out">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" class="logout-icon"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                            <span class="logout-text" style="margin-left: 8px;">Sign out</span>
                        </button>
                    </form>
                </div>
            </aside>
            
            <!-- Main Content Area -->
            <div class="main-content">
                <!-- Mobile Header -->
                <header class="mobile-header">
                    <button class="mobile-menu-toggle" aria-label="Toggle menu">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
                    </button>
                    <a class="sidebar-brand" asp-controller="Dashboard" asp-action="Index">
                        <img src="~/images/motherson-logo.png" alt="Motherson" class="sidebar-logo" />
                        <span class="sidebar-brand-text">Box Management</span>
                    </a>
                    <div style="width: 44px; font-size: 0.68rem; opacity: 0.6; text-align: right;">@releaseVersion</div>
                </header>
                
                
                <!-- Main Body -->
                <main id="main-content" class="content-body" role="main">
                    @RenderBody()
                </main>
            </div>
        </div>
    }
    else
    {
        <main id="main-content" role="main">
            @RenderBody()
        </main>
    }

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" asp-append-version="true"></script>
    <script src="~/js/station-terminal.js" asp-append-version="true"></script>
    <script src="~/js/adaptive-pagination.js" asp-append-version="true"></script>
    @if (User.Identity?.IsAuthenticated == true)
    {
    <script src="~/js/scanner.js" asp-append-version="true"></script>
    }
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const toggle = document.querySelector('.mobile-menu-toggle');
            const sidebar = document.querySelector('.sidebar');
            const overlay = document.querySelector('.sidebar-overlay');
            
            if (toggle && sidebar && overlay) {
                toggle.addEventListener('click', () => {
                    sidebar.classList.toggle('show');
                    overlay.classList.toggle('show');
                });
                
                overlay.addEventListener('click', () => {
                    sidebar.classList.remove('show');
                    overlay.classList.remove('show');
                });
            }

            // Desktop Sidebar Collapse Toggle
            const collapseBtn = document.querySelector('.sidebar-collapse-btn');
            if (collapseBtn) {
                collapseBtn.addEventListener('click', () => {
                    const collapsed = document.body.classList.toggle('sidebar-collapsed');
                    localStorage.setItem('sidebar-collapsed', collapsed);
                });
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
