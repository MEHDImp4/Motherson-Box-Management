@model MothersonBoxManagement.ViewModels.PrepareViewModel
@{
    ViewData["Title"] = $"Préparation Box {Model.Box.BoxNumber}";
    var progress = Model.ProgressPercent;
    var successMsg = TempData["ScanSuccess"] as string;
    var errorMsg = TempData["ScanError"] as string;
}

<div class="container mt-4">
    <a asp-action="Index" asp-controller="Home" class="btn btn-outline-secondary btn-sm mb-3">← Retour</a>

    @if (!string.IsNullOrEmpty(successMsg))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @successMsg
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (!string.IsNullOrEmpty(errorMsg))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @errorMsg
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">
        <div class="col-md-8">
            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <h2 style="font-weight: 600; font-size: 24px;">@Model.Box.BoxNumber (Préparation)</h2>
                        <span class="badge bg-success">@Model.Box.Status</span>
                    </div>

                    <div class="row mb-3">
                        <div class="col-sm-4"><strong>Code-barres:</strong></div>
                        <div class="col-sm-8">@Model.Box.BarcodeValue</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4"><strong>Type:</strong></div>
                        <div class="col-sm-8">@Model.Box.Type</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4"><strong>Dimensions:</strong></div>
                        <div class="col-sm-8">@Model.Box.Height × @Model.Box.Width × @Model.Box.Depth cm</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4"><strong>Créé par:</strong></div>
                        <div class="col-sm-8">@Model.Box.CreatedByMatricule le @Model.Box.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                    </div>

                    <h5 class="mt-4" style="font-weight: 600;">Progression</h5>
                    <div class="progress mt-2 @(TempData["ScanSuccess"] != null ? "pulse-success" : "")" style="height: 24px;">
                        <div id="progressBarFill" class="progress-bar @(progress >= 100 ? "bg-success" : "bg-primary")" style="width: @progress%; font-size:14px;">
                            @Model.Box.CurrentQuantity / @Model.Box.ExpectedQuantity
                        </div>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <h5 style="font-weight: 600;">Scanner un paquet</h5>
                    <div id="scanFeedback"></div>
                    <form asp-action="Scan" method="post" id="scanForm">
                        <input type="hidden" name="boxId" id="scanBoxId" value="@Model.Box.Id" />
                        <input type="hidden" name="boxBarcode" id="scanBoxBarcode" value="@Model.Box.BarcodeValue" />
                        <div class="input-group">
                            <input type="text" name="barcode" id="scanInput" class="form-control" placeholder="@(Model.Box.Status == MothersonBoxManagement.Entities.BoxStatus.Completed ? "Box complétée" : "Scanner ou taper un code-barres paquet...")" @(!Model.IsBoxOpen || Model.IsCapacityReached ? "disabled" : "") minlength="3" autofocus />
                            <button type="submit" id="scanBtn" class="btn" style="background-color: #0f52ba; color: #fff;" @(!Model.IsBoxOpen || Model.IsCapacityReached ? "disabled" : "")>Scanner</button>
                        </div>
                    </form>

                    <div class="mt-3">
                        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="toggleSimulator(event)">Ouvrir le simulateur</button>
                    </div>

                    <div id="simulatorContainer" style="display: none;">
                        <partial name="_SimulatorPanel" model="Model" />
                    </div>
                </div>
            </div>

            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 id="packageCountHeader" style="font-weight: 600;">Paquets (<span id="packageCount">@Model.Box.Packages.Count</span>)</h5>
                    @if (Model.Box.Packages.Count == 0)
                    {
                        <p id="noPackagesPlaceholder" class="text-muted">Aucun paquet scanné.</p>
                        <table class="table table-sm" id="packageTable" style="display: none;">
                            <thead>
                                <tr><th>Code-barres</th><th>Scanné par</th><th>Date</th></tr>
                            </thead>
                            <tbody id="packageTableBody">
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p id="noPackagesPlaceholder" class="text-muted" style="display: none;">Aucun paquet scanné.</p>
                        <table class="table table-sm" id="packageTable">
                            <thead>
                                <tr><th>Code-barres</th><th>Scanné par</th><th>Date</th></tr>
                            </thead>
                            <tbody id="packageTableBody">
                                @foreach (var pkg in Model.Box.Packages.OrderByDescending(p => p.ScannedAt))
                                {
                                    <tr>
                                        <td><code>@pkg.PackageBarcode</code></td>
                                        <td>@pkg.ScannedByMatricule</td>
                                        <td>@pkg.ScannedAt.ToString("dd/MM/yyyy HH:mm:ss")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/scanner.js" asp-append-version="true"></script>
    <script>
        function toggleSimulator(event) {
            var container = document.getElementById('simulatorContainer');
            var btn = event.currentTarget || event.target;
            if (container.style.display === 'none') {
                container.style.display = 'block';
                btn.textContent = 'Fermer le simulateur';
            } else {
                container.style.display = 'none';
                btn.textContent = 'Ouvrir le simulateur';
            }
        }
    </script>
}
