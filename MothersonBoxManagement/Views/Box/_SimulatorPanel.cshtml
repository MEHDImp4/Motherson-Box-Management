@model MothersonBoxManagement.ViewModels.PrepareViewModel

<div class="card mt-3 bg-light">
    <div class="card-body">
        <h6 style="font-weight: 600;">Simulateur de scan</h6>
        <p class="small text-muted">Générez des codes-barres de test et scannez-les directement.</p>
        <form method="post" id="simForm" class="row g-2" onsubmit="return false;">
            <input type="hidden" name="boxId" value="@Model.Box.Id" />
            <input type="hidden" name="boxBarcode" value="@Model.Box.BarcodeValue" />
            <input type="hidden" name="barcode" id="simBarcode" value="" />
            <div class="col-md-4">
                <label class="form-label small">Prefixe</label>
                <input type="text" id="simPrefix" class="form-control form-control-sm" value="PKG-TEST-" />
            </div>
            <div class="col-md-4">
                <label class="form-label small">Nombre</label>
                <input type="number" id="simCount" class="form-control form-control-sm" value="1" min="1" max="10" />
            </div>
            <div class="col-md-4 d-flex align-items-end">
                <button type="button" id="simSubmitBtn" class="btn btn-sm btn-outline-primary w-100" onclick="doSimScan()">Générer et scanner</button>
            </div>
        </form>
        <div id="simResults" class="mt-2"></div>
    </div>
</div>

<script>
    async function doSimScan() {
        var prefix = document.getElementById('simPrefix').value;
        var count = parseInt(document.getElementById('simCount').value) || 1;
        if (count < 1) count = 1;
        if (count > 10) count = 10;

        var form = document.getElementById('simForm');
        var boxId = form.querySelector('input[name="boxId"]').value;
        var boxBarcode = form.querySelector('input[name="boxBarcode"]').value;
        var button = document.getElementById('simSubmitBtn');
        var resultsContainer = document.getElementById('simResults');

        // Clear previous results
        resultsContainer.innerHTML = '';

        button.disabled = true;

        var csrfTokenMeta = document.querySelector('meta[name="RequestVerificationToken"]');
        var csrfToken = csrfTokenMeta ? csrfTokenMeta.content : "";

        for (var i = 0; i < count; i++) {
            var barcode = prefix + Date.now() + "-" + (i + 1);
            button.textContent = "Scan " + (i + 1) + "/" + count + "...";

            var formData = new FormData();
            formData.append('boxId', boxId);
            formData.append('boxBarcode', boxBarcode);
            formData.append('barcode', barcode);

            try {
                var response = await fetch('/Box/ScanAjax', {
                    method: 'POST',
                    headers: {
                        'X-CSRF-TOKEN': csrfToken
                    },
                    body: formData
                });

                if (!response.ok) {
                    throw new Error("HTTP error " + response.status);
                }

                var data = await response.json();

                // Append badge to resultsContainer
                var badge = document.createElement('span');
                badge.className = "scan-result-badge " + (data.success ? 'success' : 'error') + " me-1 mb-1 d-inline-block";
                badge.textContent = barcode + ": " + data.message;
                resultsContainer.appendChild(badge);

                if (data.success) {
                    if (typeof addPackageRow === 'function') {
                        addPackageRow(data.package);
                    }
                    if (typeof updateProgressBar === 'function') {
                        updateProgressBar(data.currentQuantity, data.expectedQuantity);
                    }
                }

                if (data.status === "Completed") {
                    if (typeof disableScanInput === 'function') {
                        disableScanInput();
                    }
                    break;
                }
            } catch (e) {
                console.error(e);
                var badge = document.createElement('span');
                badge.className = "scan-result-badge error me-1 mb-1 d-inline-block";
                badge.textContent = barcode + ": Erreur de connexion";
                resultsContainer.appendChild(badge);
            }

            if (i < count - 1) {
                await new Promise(r => setTimeout(r, 200));
            }
        }

        button.disabled = false;
        button.textContent = "Générer et scanner";
    }
</script>
