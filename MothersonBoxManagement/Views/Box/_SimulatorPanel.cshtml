@model MothersonBoxManagement.ViewModels.PrepareViewModel

<div class="simulator-panel" style="background-color: var(--surface-container-low); border: 1px solid var(--border); border-radius: var(--radius-md); padding: 16px;">
    <div class="d-flex align-items-center gap-2 mb-3">
        <span style="width: 8px; height: 8px; border-radius: 50%; background-color: var(--primary);"></span>
        <h4 style="font-size: 14px; font-weight: 700; margin: 0; text-transform: uppercase; color: var(--on-surface);">Barcode Simulator Tool</h4>
    </div>
    <p class="body-md text-muted mb-3" style="font-size: 13px;">Generate custom mock barcodes and simulate instant USB wedge scanner inputs (AJAX).</p>
    
    <form method="post" id="simForm" class="row g-3 align-items-end" onsubmit="return false;">
        <input type="hidden" name="boxId" value="@Model.Box.Id" />
        <input type="hidden" name="boxBarcode" value="@Model.Box.BarcodeValue" />
        <input type="hidden" name="barcode" id="simBarcode" value="" />
        
        <div class="col-sm-5">
            <label class="form-label label-md" for="simPrefix" style="font-size: 12px; font-weight: 600;">Package Prefix</label>
            <input type="text" id="simPrefix" class="form-control" value="PKG-TEST-" style="min-height: 40px; font-size: 13px;" />
        </div>
        <div class="col-sm-3">
            <label class="form-label label-md" for="simCount" style="font-size: 12px; font-weight: 600;">Quantity</label>
            <input type="number" id="simCount" class="form-control" value="1" min="1" max="10" style="min-height: 40px; font-size: 13px;" />
        </div>
        <div class="col-sm-4">
            <button type="button" id="simSubmitBtn" class="btn btn-outline-custom w-100" onclick="doSimScan()"
                    style="min-height: 40px; font-size: 13px; font-weight: 600;">
                Inject Scan(s)
            </button>
        </div>
    </form>
    
    <div id="simResults" class="mt-3 d-flex flex-wrap gap-1"></div>
</div>

<script>
    async function doSimScan() {
        var prefix = document.getElementById('simPrefix').value;
        var count = parseInt(document.getElementById('simCount').value) || 1;
        if (count < 1) count = 1;
        if (count > 10) count = 10;

        var form = document.getElementById('simForm');
        var boxId = form.querySelector('input[name="boxId"]').value;
        var boxBarcode = form.querySelector('input[name="boxBarcode"]').value;
        var button = document.getElementById('simSubmitBtn');
        var resultsContainer = document.getElementById('simResults');

        resultsContainer.innerHTML = '';
        button.disabled = true;

        var csrfTokenMeta = document.querySelector('meta[name="RequestVerificationToken"]');
        var csrfToken = csrfTokenMeta ? csrfTokenMeta.content : "";

        for (var i = 0; i < count; i++) {
            var barcode = prefix + Date.now() + "-" + (i + 1);
            button.textContent = "Injecting " + (i + 1) + "/" + count + "...";

            var formData = new FormData();
            formData.append('boxId', boxId);
            formData.append('boxBarcode', boxBarcode);
            formData.append('barcode', barcode);

            try {
                var response = await fetch('/Box/ScanAjax', {
                    method: 'POST',
                    headers: { 'X-CSRF-TOKEN': csrfToken },
                    body: formData
                });

                if (!response.ok) throw new Error("HTTP error " + response.status);

                var data = await response.json();

                var badge = document.createElement('span');
                badge.className = "scan-result-badge " + (data.success ? 'success' : 'error') + " d-inline-block";
                badge.style.fontSize = "11px";
                badge.style.padding = "4px 8px";
                badge.style.borderRadius = "4px";
                badge.textContent = barcode + ": " + data.message;
                resultsContainer.appendChild(badge);

                if (data.success) {
                    if (typeof addPackageRow === 'function') addPackageRow(data.package);
                    if (typeof updateProgressBar === 'function') updateProgressBar(data.currentQuantity, data.expectedQuantity);
                }

                if (data.status === "Completed") {
                    if (typeof disableScanInput === 'function') disableScanInput();
                    break;
                }
            } catch (e) {
                console.error(e);
                var badge = document.createElement('span');
                badge.className = "scan-result-badge error d-inline-block";
                badge.style.fontSize = "11px";
                badge.style.padding = "4px 8px";
                badge.style.borderRadius = "4px";
                badge.textContent = barcode + ": Connection error";
                resultsContainer.appendChild(badge);
            }

            if (i < count - 1) await new Promise(r => setTimeout(r, 200));
        }

        button.disabled = false;
        button.textContent = "Inject Scan(s)";
    }
</script>
