@model MothersonBoxManagement.Models.PackageSearchPageViewModel
@{ ViewData["Title"] = "Package Search"; }

<div class="container" style="padding-top: var(--space-md);">
    <div class="page-header">
        <div><h1 class="page-title">Package Search</h1><p class="body-md text-muted mb-0">Find a scanned package or browse all package associations.</p></div>
        <a asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-custom">Back to Dashboard</a>
    </div>
    <div class="row g-4 mb-4">
        <div class="col-xl-7"><div class="card h-100"><div class="card-body">
            <h2 class="section-title mb-2">Scan or search a package</h2><p class="text-muted mb-3">Use the package barcode to identify its box immediately.</p>
            <form asp-action="SearchPackage" method="post"><input type="hidden" name="pageSize" value="@Model.PageSize" />@Html.AntiForgeryToken()<div class="input-group"><input type="text" name="barcode" value="@Model.Query" id="barcodeInput" class="form-control" placeholder="Scan the package barcode…" autocomplete="off" autofocus /><button class="btn btn-primary-custom" type="submit">Search package</button></div></form>
            @if (!string.IsNullOrWhiteSpace(Model.Error)) { <div class="alert alert-danger mt-3 mb-0" role="alert">@Model.Error</div> }
        </div></div></div>
        <div class="col-xl-5">
            @if (Model.FoundBox is not null) { <div class="card h-100"><div class="card-header">Package found</div><div class="card-body"><div class="alert alert-success">@Model.SearchedBarcode is in <strong>@Model.FoundBox.BoxNumber</strong>.</div><div class="info-row"><span class="info-row-label">Box status</span><span class="info-row-value"><span class="badge-status @Model.FoundBox.Status.ToString().ToLowerInvariant()">@Model.FoundBox.Status</span></span></div><div class="info-row"><span class="info-row-label">Fill level</span><span class="info-row-value">@Model.FoundBox.CurrentQuantity / @Model.FoundBox.ExpectedQuantity packages</span></div><a asp-action="Details" asp-route-barcode="@Model.FoundBox.BarcodeValue" class="btn btn-primary-custom mt-3">View box</a></div></div> }
            else { <div class="card h-100"><div class="card-body empty-state"><div class="empty-state-icon">⌁</div><h2 class="empty-state-title">Live package lookup</h2><p class="empty-state-text mb-0">The complete register is shown below and updates from the active query.</p></div></div> }
        </div>
    </div>
    <div class="card workspace-card"><div class="card-header"><h2 class="section-title mb-0">Registered packages</h2><span class="badge-status archived">@Model.TotalItems package(s)</span></div>
        @if (Model.Packages.Count == 0) { <div class="empty-state"><h3 class="empty-state-title">No packages found</h3><p class="empty-state-text">No package associations match this search.</p></div> }
        else { <div class="table-responsive"><table class="table table-hover align-middle" data-adaptive-pagination><thead><tr><th>Package barcode</th><th>Box</th><th>Box status</th><th>Association state</th><th>Scanned</th><th class="text-end">Action</th></tr></thead><tbody>@foreach (var package in Model.Packages) { var state = package.IsRemoved ? "Removed" : package.IsBlocked ? "Blocked" : "Active"; var stateClass = package.IsRemoved ? "archived" : package.IsBlocked ? "blocked" : "open"; <tr><td><code>@package.Barcode</code></td><td><strong>@package.BoxNumber</strong></td><td><span class="badge-status @package.BoxStatus.ToLowerInvariant()">@package.BoxStatus</span></td><td><span class="badge-status @stateClass">@state</span></td><td>@package.ScannedAt.ToString("dd/MM/yyyy HH:mm")</td><td class="text-end"><a asp-action="Details" asp-route-barcode="@package.BoxBarcode" class="btn btn-outline-custom btn-sm">View box</a></td></tr>}</tbody></table></div>
        @if (Model.TotalPages > 1) { <nav class="adaptive-pager" aria-label="Package pagination"><span class="data-summary">Showing @Model.RangeStart-@Model.RangeEnd of @Model.TotalItems</span><div class="adaptive-pager__controls"><a asp-action="SearchPackage" asp-route-query="@Model.Query" asp-route-page="@(Model.CurrentPage - 1)" asp-route-pageSize="@Model.PageSize" class="btn btn-outline-custom btn-sm @(Model.CurrentPage == 1 ? "disabled" : "")">Previous</a><span class="badge-status archived">Page @Model.CurrentPage / @Model.TotalPages</span><a asp-action="SearchPackage" asp-route-query="@Model.Query" asp-route-page="@(Model.CurrentPage + 1)" asp-route-pageSize="@Model.PageSize" class="btn btn-outline-custom btn-sm @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">Next</a></div></nav> }
        }
    </div>
</div>
