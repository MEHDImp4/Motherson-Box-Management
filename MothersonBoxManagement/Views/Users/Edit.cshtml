@model MothersonBoxManagement.ViewModels.EditUserViewModel
@{
    ViewData["Title"] = "Edit User";
}

<div class="container" style="max-width: 600px; padding-top: var(--space-md);">
    <a asp-action="Index" class="back-link">&#8592; Back to Users</a>

    <div class="card" style="border: 1px solid var(--border);">
        <div class="card-body" style="padding: var(--space-xl);">
            <h2 class="headline-lg" style="margin-bottom: 4px; font-weight: 700;">Edit User Profile</h2>
            <p class="body-md text-muted mb-lg">Modify full name details, update system access roles, or activate/deactivate accounts.</p>

            <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />

                <div class="mb-3">
                    <label asp-for="FullName" class="form-label">Full Name</label>
                    <input asp-for="FullName" class="form-control" style="min-height: 44px;" />
                    <span asp-validation-for="FullName" class="text-danger mt-1 d-block"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Role" class="form-label">Access Role</label>
                    <select asp-for="Role" class="form-select" style="min-height: 44px;">
                        <option value="Operator">Operator (Standard scanning & box creation)</option>
                        <option value="Supervisor">Supervisor (Quarantine, transfers & forced closure)</option>
                        <option value="Administrator">Administrator (IT User & Audit control)</option>
                    </select>
                    <span asp-validation-for="Role" class="text-danger mt-1 d-block"></span>
                </div>

                <div class="mb-4 form-check" style="padding-left: 2em; margin-top: 1.5em; margin-bottom: 1.5em;">
                    <input asp-for="IsActive" class="form-check-input" style="width: 20px; height: 20px; margin-left: -2em; cursor: pointer;" />
                    <label asp-for="IsActive" class="form-check-label" style="font-size: 14px; font-weight: 600; padding-left: 0.5em; cursor: pointer;">Account Active</label>
                </div>

                <div class="d-flex flex-column flex-sm-row gap-3">
                    <a asp-action="Index" class="btn btn-outline-custom flex-grow-1" style="min-height: 48px;">Cancel</a>
                    <button type="submit" class="btn btn-primary-custom btn-primary-large flex-grow-1" style="min-height: 48px;">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
