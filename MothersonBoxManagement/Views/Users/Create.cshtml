@model MothersonBoxManagement.Models.CreateUserViewModel
@{
    ViewData["Title"] = "Create User";
}

<div class="container" style="max-width: 600px; padding-top: var(--space-md);">
    <a asp-action="Index" class="back-link d-inline-flex align-items-center">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" style="margin-right: 6px;"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
        Back to Users
    </a>

    <div class="card" style="border: 1px solid var(--border);">
        <div class="card-body" style="padding: var(--space-xl);">
            <h2 class="headline-lg" style="margin-bottom: 4px; font-weight: 700;">Create User Account</h2>
            <p class="body-md text-muted mb-lg">Define a new employee login identity and select their access permissions.</p>

            <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label asp-for="Matricule" class="form-label">Employee ID (Matricule)</label>
                    <input asp-for="Matricule" class="form-control" placeholder="e.g. OP002" style="min-height: 44px;" />
                    <span asp-validation-for="Matricule" class="text-danger mt-1 d-block"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="FullName" class="form-label">Full Name</label>
                    <input asp-for="FullName" class="form-control" placeholder="First and last name" style="min-height: 44px;" />
                    <span asp-validation-for="FullName" class="text-danger mt-1 d-block"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Role" class="form-label">Access Role</label>
                    <select asp-for="Role" class="form-select" style="min-height: 44px;">
                        <option value="Operator">Operator (Standard scanning & box creation)</option>
                        <option value="Supervisor">Supervisor (Quarantine, transfers & forced closure)</option>
                        <option value="Administrator">Administrator (IT User & Audit control)</option>
                    </select>
                    <span asp-validation-for="Role" class="text-danger mt-1 d-block"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label">Password</label>
                    <input asp-for="Password" class="form-control" type="password" placeholder="••••••••" style="min-height: 44px;" />
                    <span asp-validation-for="Password" class="text-danger mt-1 d-block"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="ConfirmPassword" class="form-label">Confirm Password</label>
                    <input asp-for="ConfirmPassword" class="form-control" type="password" placeholder="••••••••" style="min-height: 44px;" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger mt-1 d-block"></span>
                </div>

                <div class="d-flex flex-column flex-sm-row gap-3 mt-4">
                    <a asp-action="Index" class="btn btn-outline-custom flex-grow-1" style="min-height: 48px;">Cancel</a>
                    <button type="submit" class="btn btn-primary-custom btn-primary-large flex-grow-1" style="min-height: 48px;">Create User</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
