@model IReadOnlyList<MothersonBoxManagement.Entities.PasswordResetRequest>
@{
    ViewData["Title"] = "Password Reset Requests";
}

<div class="container" style="padding-top: var(--space-md);">
    <div class="page-header">
        <div>
            <h1 class="page-title">Password Reset Requests</h1>
            <p class="body-md text-muted mb-0">Approve verified recovery requests. Each approved request is valid for 15 minutes.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-custom">Back to users</a>
    </div>

    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success" role="status">@success</div>
    }
    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-danger" role="alert">@error</div>
    }

    <div class="card workspace-card">
        <div class="card-header">
            <h2 class="section-title mb-0">Pending approvals</h2>
            <span class="badge-status @(Model.Count > 0 ? "blocked" : "archived")">@Model.Count pending</span>
        </div>
        @if (Model.Count == 0)
        {
            <div class="empty-state">
                <div class="empty-state-icon">✓</div>
                <h3 class="empty-state-title">No pending requests</h3>
                <p class="empty-state-text mb-0">New employee requests will appear here for administrator approval.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead><tr><th>Employee</th><th>Matricule</th><th>Requested</th><th>Origin</th><th class="text-end">Action</th></tr></thead>
                    <tbody>
                    @foreach (var request in Model)
                    {
                        <tr>
                            <td><strong>@request.User.FullName</strong></td>
                            <td><code>@request.User.Matricule</code></td>
                            <td>@request.RequestedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@(string.IsNullOrWhiteSpace(request.RequestedFromIp) ? "Not recorded" : request.RequestedFromIp)</td>
                            <td class="text-end">
                                <form asp-action="ApprovePasswordReset" method="post" class="d-inline" onsubmit="return confirm('Approve password recovery for @request.User.FullName? The temporary recovery session will expire in 15 minutes.');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="requestId" value="@request.Id" />
                                    <button type="submit" class="btn btn-primary-custom btn-sm">Approve recovery</button>
                                </form>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
