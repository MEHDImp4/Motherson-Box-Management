@model MothersonBoxManagement.Models.ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset Password";
}

<div class="container" style="max-width: 600px; padding-top: var(--space-md);">
    <a asp-action="Index" class="back-link d-inline-flex align-items-center">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" style="margin-right: 6px;"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
        Back to Users
    </a>

    <div class="card" style="border: 1px solid var(--border);">
        <div class="card-body" style="padding: var(--space-xl);">
            <h2 class="headline-lg" style="margin-bottom: 4px; font-weight: 700;">Reset Password</h2>
            <p class="body-md text-muted mb-3">Set a new security password for the employee account.</p>
            <div class="mb-4" style="background-color: var(--surface-container-low); padding: 12px 16px; border-radius: var(--radius-md); border: 1px solid var(--border);">
                <span class="label-md">Target Account:</span>
                <strong style="font-size: 14px; color: var(--on-surface); margin-left: 8px;">@Model.Matricule</strong>
            </div>

            <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

            <form asp-action="ResetPassword" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="Matricule" />

                <div class="mb-3">
                    <label asp-for="NewPassword" class="form-label">New Password</label>
                    <input asp-for="NewPassword" class="form-control" type="password" placeholder="••••••••" style="min-height: 44px;" />
                    <span asp-validation-for="NewPassword" class="text-danger mt-1 d-block"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="ConfirmPassword" class="form-label">Confirm New Password</label>
                    <input asp-for="ConfirmPassword" class="form-control" type="password" placeholder="••••••••" style="min-height: 44px;" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger mt-1 d-block"></span>
                </div>

                <div class="d-flex flex-column flex-sm-row gap-3 mt-4">
                    <a asp-action="Index" class="btn btn-outline-custom flex-grow-1" style="min-height: 48px;">Cancel</a>
                    <button type="submit" class="btn btn-primary-custom btn-primary-large flex-grow-1" style="min-height: 48px;">Reset Password</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
