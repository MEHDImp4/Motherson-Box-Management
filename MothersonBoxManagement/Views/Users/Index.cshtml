@model MothersonBoxManagement.ViewModels.UserListViewModel
@{
    ViewData["Title"] = "User Accounts";
}

<div class="container" style="padding-top: var(--space-md);">
    <div class="page-header d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="page-title" style="font-size: 24px; font-weight: 700;">User Account Management</h1>
            <p class="body-md text-muted mb-0">Create new operator profiles, adjust access roles, and perform password resets.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary-custom" style="font-weight: 600;">+ New User</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
            <strong>Success:</strong> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card" style="border: 1px solid var(--border); overflow: hidden;">
        <div class="card-header" style="background-color: var(--surface-container-low); padding: 12px 20px;">
            <h2 class="section-title" style="margin: 0; font-size: 16px; font-weight: 700;">Active System Users</h2>
        </div>

        @if (Model.Users.Count == 0)
        {
            <div class="empty-state" style="padding: 48px var(--space-lg);">
                <div class="empty-state-icon" style="margin-bottom: var(--space-sm); color: var(--secondary);">
                    <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                </div>
                <h3 class="empty-state-title">No Users Found</h3>
                <p class="empty-state-text">There are currently no registered users in the database.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Matricule (ID)</th>
                            <th>Full Name</th>
                            <th>Role Status</th>
                            <th>Account Status</th>
                            <th class="text-end" style="padding-right: var(--space-lg);">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model.Users)
                        {
                            <tr style="@(user.IsActive ? "" : "opacity: 0.6; background-color: var(--surface-container-low);")">
                                <td>
                                    <strong style="font-size: 13px; color: var(--on-surface);">@user.Matricule</strong>
                                </td>
                                <td>
                                    <span style="font-size: 14px; font-weight: 600;">@user.FullName</span>
                                </td>
                                <td>
                                    <span class="badge-status @(user.Role == "Administrator" ? "cancelled" : user.Role == "Supervisor" ? "blocked" : "open")" style="font-size: 11px;">
                                        @user.Role
                                    </span>
                                </td>
                                <td>
                                    @if (user.IsActive)
                                    {
                                        <span class="badge-status open" style="font-size: 11px;">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge-status archived" style="font-size: 11px;">Inactive</span>
                                    }
                                </td>
                                <td class="text-end" style="padding-right: var(--space-lg);">
                                    <div class="d-flex gap-2 justify-content-end align-items-center">
                                        <a asp-action="Edit" asp-route-id="@user.Id"
                                           class="btn btn-outline-custom btn-sm" style="min-height: 36px; padding: 0 16px; font-size: 13px;">Edit Profile</a>
                                        <a asp-action="ResetPassword" asp-route-id="@user.Id"
                                           class="btn btn-outline-custom btn-sm" style="min-height: 36px; padding: 0 16px; font-size: 13px; color: var(--status-blocked); border-color: var(--status-blocked);">Password</a>
                                        @if (user.IsActive)
                                        {
                                            <form asp-action="Deactivate" asp-route-id="@user.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to deactivate the user profile for @user.FullName? This will revoke login permissions.')">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-outline-custom btn-sm"
                                                        style="min-height: 36px; padding: 0 16px; font-size: 13px; color: var(--error); border-color: var(--error); background-color: transparent;">
                                                    Deactivate
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
