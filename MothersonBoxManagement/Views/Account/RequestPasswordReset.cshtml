@model MothersonBoxManagement.Models.PasswordResetRequestViewModel
@{
    ViewData["Title"] = "Request password reset";
}
<div class="login-page">
    <div class="login-card">
        <h1 class="login-title">Request password reset</h1>
        @if (ViewBag.Submitted == true)
        {
            <div class="alert alert-success" role="status">If this active account exists, the request was sent to an administrator.</div>
        }
        <form asp-action="RequestPasswordReset" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
            <div class="mb-3">
                <label asp-for="Matricule" class="form-label">Employee ID (Matricule)</label>
                <input asp-for="Matricule" class="form-control" autocomplete="username" />
                <span asp-validation-for="Matricule" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary-custom w-100">Send request</button>
        </form>
        <div class="text-center mt-3"><a asp-action="Login">Back to sign in</a> · <a asp-action="RecoveryLogin">Already approved?</a></div>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
