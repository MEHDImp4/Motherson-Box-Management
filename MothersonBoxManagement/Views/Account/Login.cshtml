@model MothersonBoxManagement.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Connexion";
    Layout = "_Layout";
}

<div class="d-flex align-items-center justify-content-center min-vh-100">
    <div class="card shadow-sm" style="max-width: 420px; width: 100%;">
        <div class="card-body p-4">
            <h2 class="text-center mb-4" style="font-weight: 600; font-size: 24px;">Motherson Box Management</h2>

            <form asp-action="Login" method="post">
                <input type="hidden" asp-for="ReturnUrl" />

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3" style="color: #df2c3f !important;" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="Matricule" class="form-label" style="font-size: 14px;">Matricule</label>
                    <input asp-for="Matricule" class="form-control" placeholder="Matricule" autocomplete="username" />
                    <span asp-validation-for="Matricule" class="text-danger" style="color: #df2c3f !important; font-size: 14px;"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Password" class="form-label" style="font-size: 14px;">Mot de passe</label>
                    <input asp-for="Password" class="form-control" placeholder="Mot de passe" autocomplete="current-password" />
                    <span asp-validation-for="Password" class="text-danger" style="color: #df2c3f !important; font-size: 14px;"></span>
                </div>

                <button type="submit" class="btn w-100" style="background-color: #0f52ba; color: #ffffff; font-weight: 600;">Se connecter</button>
            </form>

            <div class="mt-4 p-3 bg-light rounded text-muted" style="font-size: 13px; border: 1px solid #e3e8ee;">
                <h6 class="mb-2 text-dark" style="font-weight: 600; font-size: 14px;">Comptes de test (Seeded) :</h6>
                <div class="mb-1"><strong>Opérateur :</strong> Matricule <code>OP001</code></div>
                <div class="mb-1"><strong>Superviseur :</strong> Matricule <code>SP001</code></div>
                <div class="mb-1"><strong>Administrateur :</strong> Matricule <code>AD001</code></div>
                <div class="mt-2"><strong>Mot de passe :</strong> <code>Motherson2026!</code></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
