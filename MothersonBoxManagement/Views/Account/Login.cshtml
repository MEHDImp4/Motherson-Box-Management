@model MothersonBoxManagement.Models.LoginViewModel
@{
    ViewData["Title"] = "Sign in";
    Layout = "_Layout";
}

<div class="login-page">
    <div class="login-card">
        <div class="login-logo">
            <img src="~/images/motherson-logo.png" alt="Motherson Logo" />
        </div>

        <h1 class="login-title" style="margin-bottom: 4px; font-size: 24px; font-weight: 700;">Motherson Box Management</h1>
        <p style="text-align: center; color: var(--secondary); font-size: 14px; margin-bottom: 24px;">P3 Packaging Area Traceability System</p>

        <form asp-action="Login" method="post">
            <input type="hidden" asp-for="ReturnUrl" />

            <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3" role="alert"></div>

            <div class="mb-3">
                <label asp-for="Matricule" class="form-label">Employee ID (Matricule)</label>
                <input asp-for="Matricule" class="form-control" placeholder="Enter your employee ID (e.g. OP001)" autocomplete="username" autofocus />
                <span asp-validation-for="Matricule" class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Password" class="form-label">Password</label>
                <div class="input-group">
                    <input asp-for="Password" type="password" id="passwordInput" class="form-control" placeholder="Enter your password" autocomplete="current-password" style="border-top-right-radius: 0; border-bottom-right-radius: 0;" />
                    <button class="btn btn-outline-custom" type="button" id="togglePasswordBtn" style="border-top-left-radius: 0; border-bottom-left-radius: 0; min-height: 44px; padding: 0 16px; border-left: none;" aria-label="Toggle password visibility">
                        <span id="togglePasswordIcon" class="d-flex align-items-center"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg></span>
                    </button>
                </div>
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary-custom btn-primary-large w-100" style="font-weight: 600;">Sign in</button>
        </form>
        <div class="text-center mt-3 d-grid gap-2">
            <a asp-action="RequestPasswordReset">Forgot your password?</a>
            <a asp-action="RecoveryLogin" class="small">Continue an approved password reset</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const passwordInput = document.getElementById('passwordInput');
            const togglePasswordBtn = document.getElementById('togglePasswordBtn');
            const togglePasswordIcon = document.getElementById('togglePasswordIcon');
            const eyeOpenSvg = '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>';
            const eyeClosedSvg = '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>';

            if (togglePasswordBtn && passwordInput && togglePasswordIcon) {
                togglePasswordBtn.addEventListener('click', () => {
                    const type = passwordInput.getAttribute('type') === 'password' ? 'text' : 'password';
                    passwordInput.setAttribute('type', type);
                    togglePasswordIcon.innerHTML = type === 'password' ? eyeOpenSvg : eyeClosedSvg;
                });
            }
        });
    </script>
}
