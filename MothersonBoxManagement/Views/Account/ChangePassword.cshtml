@model MothersonBoxManagement.Models.ForcedPasswordChangeViewModel
@{ ViewData["Title"] = "Choose a new password"; }

<div class="login-page">
    <div class="login-card">
        <div class="text-center mb-4"><img src="~/images/motherson-logo.png" class="sidebar-logo mb-3" alt="Motherson" /><h1 class="login-title mb-2">Choose a new password</h1><p class="text-muted mb-0">Your recovery access is temporary. Set a new password to continue.</p></div>
        <form asp-action="ChangePassword" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
            <div class="mb-3"><label asp-for="NewPassword" class="form-label">New password</label><input asp-for="NewPassword" class="form-control" autocomplete="new-password" autofocus /><div class="form-text">Use at least 12 characters.</div><span asp-validation-for="NewPassword" class="text-danger"></span></div>
            <div class="mb-4"><label asp-for="ConfirmPassword" class="form-label">Confirm new password</label><input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword" class="text-danger"></span></div>
            <button type="submit" class="btn btn-primary-custom w-100">Save new password</button>
        </form>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
