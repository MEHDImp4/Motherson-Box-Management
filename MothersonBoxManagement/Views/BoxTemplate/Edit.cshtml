@model MothersonBoxManagement.Models.BoxTemplateViewModel
@{
    ViewData["Title"] = "Edit Box Template";
    var templateId = ViewBag.TemplateId as int?;
}

<div class="container" style="max-width: 800px; padding-top: var(--space-md);">
    <a asp-action="Index" class="back-link d-inline-flex align-items-center">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" style="margin-right: 6px;"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
        Back to Templates
    </a>

    <div class="card" style="border: 1px solid var(--border);">
        <div class="card-body" style="padding: var(--space-xl);">
            <h2 class="headline-lg" style="margin-bottom: 4px; font-weight: 700;">Edit Box Template</h2>
            <p class="body-md text-muted mb-lg">Update this box template configuration.</p>

            <form asp-action="Edit" asp-route-id="@templateId" method="post" id="editTemplateForm">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

                <div class="mb-4">
                    <label asp-for="Name" class="form-label">Template Name</label>
                    <input asp-for="Name" type="text" class="form-control" style="min-height: 48px;" />
                    <span asp-validation-for="Name" class="text-danger mt-1 d-block"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Description" class="form-label">Description (Optional)</label>
                    <textarea asp-for="Description" class="form-control" rows="2" style="min-height: 48px;"></textarea>
                    <span asp-validation-for="Description" class="text-danger mt-1 d-block"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="PackagePrefixPattern" class="form-label">Package Prefix Pattern (Auto-Create)</label>
                    <input asp-for="PackagePrefixPattern" type="text" class="form-control" placeholder="e.g. 12345" style="min-height: 48px;" />
                    <span asp-validation-for="PackagePrefixPattern" class="text-danger mt-1 d-block"></span>
                    <small class="form-text text-muted">When a scanned package barcode starts with this prefix, a box is automatically created from this template.</small>
                </div>

                <div class="mb-4">
                    <label class="form-label">Box Material Type</label>
                    <input type="hidden" asp-for="Type" id="TypeInput" />
                    
                    <div class="row g-3">
                        <div class="col-4">
                            <div class="card type-card p-3 text-center" data-value="0" id="type-card-0" 
                                 style="border: 1px solid var(--border); border-radius: var(--radius-md); cursor: pointer; transition: all 0.15s ease-in-out; height: 100%;">
                                <div class="d-flex justify-content-center" style="margin-bottom: 8px; color: var(--primary);">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><polyline points="21 8 21 21 3 21 3 8"/><rect x="1" y="3" width="22" height="5"/><line x1="12" y1="12" x2="12" y2="21"/></svg>
                                </div>
                                <div style="font-weight: 600; font-size: 14px; color: var(--on-surface);">Cardboard</div>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="card type-card p-3 text-center" data-value="1" id="type-card-1" 
                                 style="border: 1px solid var(--border); border-radius: var(--radius-md); cursor: pointer; transition: all 0.15s ease-in-out; height: 100%;">
                                <div class="d-flex justify-content-center" style="margin-bottom: 8px; color: var(--primary);">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
                                </div>
                                <div style="font-weight: 600; font-size: 14px; color: var(--on-surface);">Wood</div>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="card type-card p-3 text-center" data-value="2" id="type-card-2" 
                                 style="border: 1px solid var(--border); border-radius: var(--radius-md); cursor: pointer; transition: all 0.15s ease-in-out; height: 100%;">
                                <div class="d-flex justify-content-center" style="margin-bottom: 8px; color: var(--primary);">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect x="2" y="2" width="20" height="20" rx="2" ry="2"/><line x1="2" y1="9" x2="22" y2="9"/><line x1="9" y1="9" x2="9" y2="22"/><line x1="15" y1="9" x2="15" y2="22"/></svg>
                                </div>
                                <div style="font-weight: 600; font-size: 14px; color: var(--on-surface);">Plastic</div>
                            </div>
                        </div>
                    </div>
                    <span asp-validation-for="Type" class="text-danger mt-1 d-block"></span>
                </div>

                <div class="mb-4">
                    <label class="form-label">Dimensions (Outer, whole cm)</label>
                    <div class="row g-3">
                        <div class="col-4">
                            <div class="input-group">
                                <span class="input-group-text" style="background-color: var(--surface-container-low); font-size: 12px; font-weight: 600; min-height: 44px;">H</span>
                                <input asp-for="Height" type="number" step="1" min="1" id="HeightInput" class="form-control" placeholder="0" style="min-height: 44px;" />
                            </div>
                            <span asp-validation-for="Height" class="text-danger mt-1 d-block"></span>
                        </div>
                        <div class="col-4">
                            <div class="input-group">
                                <span class="input-group-text" style="background-color: var(--surface-container-low); font-size: 12px; font-weight: 600; min-height: 44px;">W</span>
                                <input asp-for="Width" type="number" step="1" min="1" id="WidthInput" class="form-control" placeholder="0" style="min-height: 44px;" />
                            </div>
                            <span asp-validation-for="Width" class="text-danger mt-1 d-block"></span>
                        </div>
                        <div class="col-4">
                            <div class="input-group">
                                <span class="input-group-text" style="background-color: var(--surface-container-low); font-size: 12px; font-weight: 600; min-height: 44px;">D</span>
                                <input asp-for="Depth" type="number" step="1" min="1" id="DepthInput" class="form-control" placeholder="0" style="min-height: 44px;" />
                            </div>
                            <span asp-validation-for="Depth" class="text-danger mt-1 d-block"></span>
                        </div>
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="ExpectedQuantity" class="form-label">Expected Package Quantity</label>
                    <input asp-for="ExpectedQuantity" type="number" min="1" id="QtyInput" class="form-control" style="min-height: 48px;" />
                    <span asp-validation-for="ExpectedQuantity" class="text-danger mt-1 d-block"></span>
                </div>

                <div class="d-flex flex-column flex-sm-row gap-3">
                    <a asp-action="Index" class="btn btn-outline-custom flex-grow-1" style="min-height: 48px;">Cancel</a>
                    <button type="submit" class="btn btn-primary-custom btn-primary-large flex-grow-1" style="min-height: 48px;">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <style>
        .type-card.selected {
            border-color: var(--primary) !important;
            background-color: var(--status-completed-bg) !important;
            box-shadow: 0 0 0 2px var(--primary);
        }
        .type-card.selected div {
            color: var(--primary) !important;
        }
    </style>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const typeInput = document.getElementById('TypeInput');
            const cards = document.querySelectorAll('.type-card');

            if (typeInput.value) {
                const selectedCard = document.getElementById(`type-card-${typeInput.value}`);
                if (selectedCard) {
                    selectedCard.classList.add('selected');
                }
            }

            cards.forEach(card => {
                card.addEventListener('click', () => {
                    cards.forEach(c => c.classList.remove('selected'));
                    card.classList.add('selected');
                    typeInput.value = card.getAttribute('data-value');
                    $(typeInput).valid();
                });
            });
        });
    </script>
}
