@model List<MothersonBoxManagement.Dtos.BoxTemplateDto>
@{
    ViewData["Title"] = "Manage Box Templates";
}

<div class="container" style="padding-top: var(--space-md);">
    <a asp-controller="Dashboard" asp-action="Index" class="back-link d-inline-flex align-items-center">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" style="margin-right: 6px;"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
        Back to Dashboard
    </a>

    <div class="d-flex align-items-center justify-content-between mb-4 mt-3">
        <div>
            <h1 class="headline-lg" style="font-weight: 700; margin-bottom: 4px;">Box Templates</h1>
            <p class="body-md text-muted" style="margin: 0;">Manage reusable templates for box creation.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary-custom" style="min-height: 44px; padding: 0 24px;">
            New Template
        </a>
    </div>

    @if (TempData["ScanSuccess"] is string success)
    {
        <div class="alert alert-success mb-4" role="alert" style="padding: 12px 16px; border-radius: var(--radius-md);">@success</div>
    }

    @if (Model.Count == 0)
    {
        <div class="card" style="border: 1px solid var(--border);">
            <div class="empty-state" style="padding: var(--space-xl) var(--space-lg);">
                <div class="empty-state-icon" style="margin-bottom: var(--space-sm); color: var(--secondary);">
                    <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/></svg>
                </div>
                <h3 class="empty-state-title">No Templates Yet</h3>
                <p class="empty-state-text">Create your first box template to allow operators to start preparing boxes.</p>
                <a asp-action="Create" class="btn btn-primary-custom" style="min-height: 44px; padding: 0 24px;">Create Template</a>
            </div>
        </div>
    }
    else
    {
        <div class="card" style="border: 1px solid var(--border); overflow: hidden;">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Type</th>
                            <th>Dimensions</th>
                            <th>Expected Qty</th>
                            <th>Prefix</th>
                            <th>Created</th>
                            <th class="text-end" style="padding-right: var(--space-lg);">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var template in Model)
                        {
                            <tr>
                                <td>
                                    <strong style="font-size: 13px; color: var(--on-surface);">@template.Name</strong>
                                    @if (!string.IsNullOrEmpty(template.Description))
                                    {
                                        <br />
                                        <small style="color: var(--secondary);">@template.Description</small>
                                    }
                                </td>
                                <td>
                                    <span class="label-md" style="font-weight: 600; text-transform: uppercase;">@template.Type</span>
                                </td>
                                <td>
                                    <span style="font-size: 13px; color: var(--on-surface);">@($"{template.Height:F0} × {template.Width:F0} × {template.Depth:F0} cm")</span>
                                </td>
                                <td>
                                    <span style="font-weight: 700; color: var(--on-surface);">@template.ExpectedQuantity</span>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(template.PackagePrefixPattern))
                                    {
                                        <code style="font-size: 12px; background: var(--surface-container-low); padding: 2px 6px; border-radius: 4px;">@template.PackagePrefixPattern</code>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    <span style="font-size: 13px; color: var(--secondary);">@template.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                                </td>
                                <td class="text-end" style="padding-right: var(--space-lg);">
                                    <div class="d-flex gap-2 justify-content-end">
                                        <a asp-action="Edit" asp-route-id="@template.Id"
                                           class="btn btn-outline-custom btn-sm" style="min-height: 36px; padding: 0 16px; font-size: 13px;">
                                            Edit
                                        </a>
                                        <form asp-action="Deactivate" asp-route-id="@template.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-custom btn-sm"
                                                    style="min-height: 36px; padding: 0 16px; font-size: 13px; color: var(--status-blocked); border-color: var(--status-blocked);"
                                                    onclick="return confirm('Are you sure you want to deactivate this template?');">
                                                Deactivate
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
