@using MothersonBoxManagement.Data.Dtos
@{
    ViewData["Title"] = "Accueil";
    var openBoxes = ViewBag.OpenBoxes as List<BoxListItemDto> ?? new List<BoxListItemDto>();
    var error = ViewBag.Error as string;
}

<div class="container mt-4">
    <div class="row justify-content-center mb-4">
        <div class="col-md-8 text-center">
            <h1 style="font-weight: 600; font-size: 32px;">Bienvenue, @ViewBag.Matricule (@ViewBag.Role)</h1>
        </div>
    </div>

    <div class="row justify-content-center mb-4">
        <div class="col-md-6">
            <form asp-action="Index" method="post" class="input-group">
                <input type="text" name="barcode" class="form-control" placeholder="Scanner ou taper un code-barres box..." autofocus />
                <button type="submit" class="btn" style="background-color: #0f52ba; color: #fff;">Rechercher</button>
            </form>
            @if (!string.IsNullOrEmpty(error))
            {
                <div class="text-danger mt-2" style="color: #df2c3f !important;">@error</div>
            }
        </div>
    </div>

    <h2 class="mb-3" style="font-weight: 600; font-size: 24px;">Boxes ouvertes</h2>

    @if (openBoxes.Count == 0)
    {
        <div class="text-center text-muted py-5">
            <p>Aucune box ouverte. <a asp-controller="Box" asp-action="Create">Créer une box</a></p>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var box in openBoxes)
            {
                var progress = box.ExpectedQuantity > 0 ? (int)((double)box.CurrentQuantity / box.ExpectedQuantity * 100) : 0;
                var progressColor = progress >= 100 ? "bg-success" : progress > 50 ? "bg-warning" : "bg-primary";

                <div class="col-md-6 col-lg-4">
                    <a asp-controller="Box" asp-action="Details" asp-route-id="@box.Id" class="text-decoration-none">
                        <div class="card shadow-sm h-100">
                            <div class="card-body">
                                <h5 class="card-title" style="font-weight: 600;">@box.BoxNumber</h5>
                                <p class="card-text text-muted small mb-2">@box.Type - Créé par @box.CreatedByMatricule</p>
                                <div class="progress mb-2" style="height: 8px;">
                                    <div class="progress-bar @progressColor" style="width: @progress%;"></div>
                                </div>
                                <small class="text-muted">@box.CurrentQuantity / @box.ExpectedQuantity paquets</small>
                                <br />
                                <small class="text-muted">@box.CreatedAt.ToString("dd/MM/yyyy HH:mm")</small>
                            </div>
                        </div>
                    </a>
                </div>
            }
        </div>
    }
</div>
