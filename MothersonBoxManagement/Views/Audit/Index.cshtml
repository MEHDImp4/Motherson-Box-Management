@model List<MothersonBoxManagement.Entities.BoxAuditLog>
@{
    ViewData["Title"] = "Journal d'Audit";
    int currentPage = ViewBag.CurrentPage;
    int totalPages = ViewBag.TotalPages;
}

@functions {
    public string FormatJson(string? json)
    {
        if (string.IsNullOrWhiteSpace(json)) return string.Empty;
        try
        {
            var parsed = System.Text.Json.JsonSerializer.Deserialize<object>(json);
            return System.Text.Json.JsonSerializer.Serialize(parsed, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
        }
        catch
        {
            return json;
        }
    }
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 style="font-weight: 600; font-size: 32px;">Journal d'Audit</h1>
        @if (ViewBag.BoxId != null)
        {
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">← Effacer le filtre Box</a>
        }
    </div>

    <!-- Filters Card -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form method="get" asp-action="Index" class="row g-3 align-items-end">
                <div class="col-md-2">
                    <label for="boxId" class="form-label">ID Box</label>
                    <input type="number" class="form-control form-control-sm" id="boxId" name="boxId" value="@ViewBag.BoxId" placeholder="ex: 12" />
                </div>
                <div class="col-md-3">
                    <label for="actionType" class="form-label">Type d'action</label>
                    <select class="form-select form-select-sm" id="actionType" name="actionType">
                        <option value="">Tous</option>
                        @if (ViewBag.ActionTypes != null)
                        {
                            @foreach (var action in (List<string>)ViewBag.ActionTypes)
                            {
                                <option value="@action" selected="@(ViewBag.ActionType == action ? "selected" : null)">@action</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-2.5">
                    <label for="fromDate" class="form-label">Du</label>
                    <input type="date" class="form-control form-control-sm" id="fromDate" name="fromDate" value="@ViewBag.FromDate" />
                </div>
                <div class="col-md-2.5">
                    <label for="toDate" class="form-label">Au</label>
                    <input type="date" class="form-control form-control-sm" id="toDate" name="toDate" value="@ViewBag.ToDate" />
                </div>
                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-primary btn-sm w-100" style="background-color: #0f52ba; border-color: #0f52ba;">Filtrer</button>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm w-100">Réinitialiser</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Audit Logs Table -->
    <div class="card shadow-sm">
        <div class="card-body p-0">
            @if (Model.Count == 0)
            {
                <div class="text-center text-muted py-5">
                    <p>Aucun enregistrement d'audit trouvé.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle mb-0" style="font-size: 14px;">
                        <thead class="table-light">
                            <tr>
                                <th>Date & Heure</th>
                                <th>Type d'action</th>
                                <th>Utilisateur</th>
                                <th>Station</th>
                                <th>Box ID</th>
                                <th>Détails</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var log in Model)
                            {
                                <tr>
                                    <td style="white-space: nowrap;">@log.Timestamp.ToString("dd/MM/yyyy HH:mm:ss")</td>
                                    <td>
                                        <span class="badge bg-info text-dark">@log.ActionType</span>
                                    </td>
                                    <td>
                                        <strong>@log.User?.Matricule</strong> <span class="text-muted">(@log.User?.Role)</span>
                                    </td>
                                    <td>@log.WorkstationName</td>
                                    <td>
                                        @if (log.BoxId.HasValue)
                                        {
                                            <a asp-controller="Box" asp-action="Details" asp-route-barcode="@(log.Box?.BarcodeValue)" class="btn btn-link btn-sm p-0">#@log.BoxId (@(log.Box?.BoxNumber ?? "Inconnu"))</a>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td style="max-width: 400px;">
                                        @if (!string.IsNullOrWhiteSpace(log.DetailsJson))
                                        {
                                            <details>
                                                <summary class="text-primary small" style="cursor: pointer;">Afficher JSON</summary>
                                                <pre class="bg-light p-2 mt-2 rounded border" style="font-size: 11px; max-height: 200px; overflow-y: auto; white-space: pre-wrap; word-break: break-all;"><code>@FormatJson(log.DetailsJson)</code></pre>
                                            </details>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <!-- Pagination -->
    @if (totalPages > 1)
    {
        <nav aria-label="Page navigation" class="mt-4">
            <ul class="pagination justify-content-center">
                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" 
                       asp-route-boxId="@ViewBag.BoxId" 
                       asp-route-actionType="@ViewBag.ActionType" 
                       asp-route-fromDate="@ViewBag.FromDate" 
                       asp-route-toDate="@ViewBag.ToDate" 
                       asp-route-page="@(currentPage - 1)">Précédent</a>
                </li>
                @for (int i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(currentPage == i ? "active" : "")">
                        <a class="page-link" asp-action="Index" 
                           asp-route-boxId="@ViewBag.BoxId" 
                           asp-route-actionType="@ViewBag.ActionType" 
                           asp-route-fromDate="@ViewBag.FromDate" 
                           asp-route-toDate="@ViewBag.ToDate" 
                           asp-route-page="@i">@i</a>
                    </li>
                }
                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" 
                       asp-route-boxId="@ViewBag.BoxId" 
                       asp-route-actionType="@ViewBag.ActionType" 
                       asp-route-fromDate="@ViewBag.FromDate" 
                       asp-route-toDate="@ViewBag.ToDate" 
                       asp-route-page="@(currentPage + 1)">Suivant</a>
                </li>
            </ul>
        </nav>
    }
</div>
