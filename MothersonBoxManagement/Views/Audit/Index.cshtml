@model List<MothersonBoxManagement.Entities.BoxAuditLog>
@{
    ViewData["Title"] = "Audit Log";
    int currentPage = ViewBag.CurrentPage;
    int totalPages = ViewBag.TotalPages;
}

@functions {
    public string FormatJson(string? json)
    {
        if (string.IsNullOrWhiteSpace(json)) return string.Empty;
        try
        {
            var parsed = System.Text.Json.JsonSerializer.Deserialize<object>(json);
            return System.Text.Json.JsonSerializer.Serialize(parsed, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
        }
        catch
        {
            return json;
        }
    }
}

<div class="container" style="padding-top: var(--space-md);">
    <div class="page-header d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="page-title" style="font-size: 24px; font-weight: 700;">Traceability Audit Log</h1>
            <p class="body-md text-muted mb-0">Review workstation history, package scans, and supervisor security overrides.</p>
        </div>
        @if (ViewBag.BoxId != null)
        {
            <a asp-action="Index" class="btn btn-outline-custom btn-sm d-inline-flex align-items-center" style="min-height: 38px; padding: 0 16px;">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" style="margin-right: 6px;"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
                Clear Box Filter
            </a>
        }
    </div>

    <!-- Filters Section -->
    <div class="card mb-4" style="border: 1px solid var(--border); background-color: var(--surface-container-lowest);">
        <div class="card-header" style="background-color: var(--surface-container-low); font-weight: 700; color: var(--on-surface);">
            Filter Log Records
        </div>
        <div class="card-body" style="padding: 20px;">
            <form method="get" asp-action="Index">
                <div class="row g-3 align-items-end">
                    <div class="col-md-2">
                        <label for="boxId" class="form-label">Box database ID</label>
                        <input type="number" class="form-control" id="boxId" name="boxId" value="@ViewBag.BoxId" placeholder="e.g. 12" style="min-height: 40px;" />
                    </div>
                    <div class="col-md-3">
                        <label for="actionType" class="form-label">Action Category</label>
                        <select class="form-select" id="actionType" name="actionType" style="min-height: 40px;">
                            <option value="">-- All Actions --</option>
                            @if (ViewBag.ActionTypes != null)
                            {
                                @foreach (var action in (List<string>)ViewBag.ActionTypes)
                                {
                                    <!option value="@action" @(ViewBag.ActionType == action ? "selected" : null)>@action</!option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label for="fromDate" class="form-label">From Date</label>
                        <input type="date" class="form-control" id="fromDate" name="fromDate" value="@ViewBag.FromDate" style="min-height: 40px;" />
                    </div>
                    <div class="col-md-2">
                        <label for="toDate" class="form-label">To Date</label>
                        <input type="date" class="form-control" id="toDate" name="toDate" value="@ViewBag.ToDate" style="min-height: 40px;" />
                    </div>
                    <div class="col-md-3 d-flex gap-2">
                        <button type="submit" class="btn btn-secondary-custom btn-sm flex-grow-1" style="min-height: 40px; font-weight: 600;">Apply Filters</button>
                        <a asp-action="Index" class="btn btn-outline-custom btn-sm" style="min-height: 40px; padding: 0 16px;">Reset</a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Audit Table Section -->
    <div class="card" style="border: 1px solid var(--border); overflow: hidden;">
        <div class="card-header d-flex justify-content-between align-items-center" style="background-color: var(--surface-container-low); padding: 12px 20px;">
            <h2 class="section-title" style="margin: 0; font-size: 16px; font-weight: 700;">System Journal</h2>
            <span class="badge-status archived" style="font-weight: 600;">@ViewBag.TotalItems record(s)</span>
        </div>

        @if (Model.Count == 0)
        {
            <div class="empty-state" style="padding: 48px var(--space-lg);">
                <div class="empty-state-icon" style="margin-bottom: var(--space-sm); color: var(--secondary);">
                    <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
                </div>
                <h3 class="empty-state-title">No Audit Logs Found</h3>
                <p class="empty-state-text">No traceability journal records matched the specified filter settings.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Date &amp; Time</th>
                            <th>Action Type</th>
                            <th>Description</th>
                            <th>User (Matricule)</th>
                            <th>Workstation</th>
                            <th>Box ID</th>
                            <th>Transaction Details</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in Model)
                        {
                            var badgeClass = log.ActionType switch
                            {
                                "BoxCreated" => "open",
                                "PackageScanned" => "open",
                                "BoxCompletedAuto" => "completed",
                                "PackageRejected" => "cancelled",
                                "BoxCancelled" => "cancelled",
                                "BoxBlocked" => "blocked",
                                "PackageBlocked" => "blocked",
                                "BoxUnblocked" => "open",
                                "PackageUnblocked" => "open",
                                "BoxForcedClosed" => "exception",
                                _ => "archived"
                            };

                            <tr>
                                <td style="white-space: nowrap; font-size: 13px; color: var(--on-surface);">
                                    @log.Timestamp.ToString("dd/MM/yyyy HH:mm:ss")
                                </td>
                                <td>
                                    <span class="badge-status @badgeClass" style="font-size: 11px; font-weight: 700; text-transform: uppercase;">
                                        @log.ActionType
                                    </span>
                                </td>
                                <td style="max-width: 260px; font-size: 13px; color: var(--on-surface);">
                                    @if (!string.IsNullOrWhiteSpace(log.Description))
                                    {
                                        @log.Description
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex flex-column">
                                        <strong style="font-size: 13px;">@log.User?.Matricule</strong>
                                        <span class="label-md" style="font-size: 10px; font-weight: 600;">@log.User?.Role</span>
                                    </div>
                                </td>
                                <td>
                                    <span style="font-size: 13px; color: var(--secondary);">@log.WorkstationName</span>
                                </td>
                                <td>
                                    @if (log.BoxId.HasValue)
                                    {
                                        <a asp-controller="Box" asp-action="Details" asp-route-barcode="@(log.Box?.BarcodeValue)"
                                           style="font-size: 13px; color: var(--primary); text-decoration: none; font-weight: 700;">
                                            #@log.BoxId
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td style="max-width: 320px;">
                                    @if (!string.IsNullOrWhiteSpace(log.DetailsJson))
                                    {
                                        <details>
                                            <summary style="cursor: pointer; font-size: 13px; color: var(--primary); font-weight: 600; outline: none;">Inspect Changes</summary>
                                            <pre style="background: var(--surface-container-low); padding: 12px; margin-top: 8px; border-radius: var(--radius-md); border: 1px solid var(--border); font-size: 11px; max-height: 250px; overflow-y: auto; white-space: pre-wrap; word-break: break-all; font-family: monospace; color: var(--on-surface);"><code>@FormatJson(log.DetailsJson)</code></pre>
                                        </details>
                                    }
                                    else
                                    {
                                        <span class="text-muted" style="font-size: 13px;">-</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <!-- Pagination Section -->
    @if (totalPages > 1)
    {
        <nav aria-label="Page navigation" class="mt-4">
            <ul class="pagination justify-content-center">
                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index"
                       asp-route-boxId="@ViewBag.BoxId"
                       asp-route-actionType="@ViewBag.ActionType"
                       asp-route-fromDate="@ViewBag.FromDate"
                       asp-route-toDate="@ViewBag.ToDate"
                       asp-route-page="@(currentPage - 1)">Previous</a>
                </li>
                @for (int i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(currentPage == i ? "active" : "")">
                        <a class="page-link" asp-action="Index"
                           asp-route-boxId="@ViewBag.BoxId"
                           asp-route-actionType="@ViewBag.ActionType"
                           asp-route-fromDate="@ViewBag.FromDate"
                           asp-route-toDate="@ViewBag.ToDate"
                           asp-route-page="@i">@i</a>
                    </li>
                }
                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Index"
                       asp-route-boxId="@ViewBag.BoxId"
                       asp-route-actionType="@ViewBag.ActionType"
                       asp-route-fromDate="@ViewBag.FromDate"
                       asp-route-toDate="@ViewBag.ToDate"
                       asp-route-page="@(currentPage + 1)">Next</a>
                </li>
            </ul>
        </nav>
    }
</div>
